# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Site ──────────────────────────────────────────────────────────────────────
# Public URL of the site — used for auth redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AI ────────────────────────────────────────────────────────────────────────
# Server-only — NEVER expose to the client (no NEXT_PUBLIC_ prefix)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Monitoring — Error Tracking (optional) ────────────────────────────────────
# Create a project at https://sentry.io and paste the DSN here
NEXT_PUBLIC_SENTRY_DSN=

# ─── Analytics — Product Analytics (optional) ─────────────────────────────────
# Create a project at https://posthog.com and paste the key here
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable a feature. Defaults are defined in lib/feature-flags.ts
NEXT_PUBLIC_FF_BETA_BADGE=true
NEXT_PUBLIC_FF_MARKET_INSIGHTS=false
NEXT_PUBLIC_FF_PROPOSAL_INTEL=false
NEXT_PUBLIC_FF_JOB_MATCH=false
NEXT_PUBLIC_FF_LEARNING_CENTER=false
NEXT_PUBLIC_FF_COMPARE_ANALYSES=false
NEXT_PUBLIC_FF_SHARE_REPORT=false
NEXT_PUBLIC_FF_EXPORT_PDF=false
NEXT_PUBLIC_FF_AI_STREAMING=false
